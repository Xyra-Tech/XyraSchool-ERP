{
  "name": "xyratech-school-erp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "XyraTech School ERP — Enterprise Multi-School Management Ecosystem",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --parallel --recursive run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @xyratech/database generate",
    "db:push": "pnpm --filter @xyratech/database db:push",
    "db:seed": "pnpm --filter @xyratech/database seed",
    "clean": "pnpm --recursive exec rimraf dist node_modules"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
