# ==============================================================================
# XyraTech School ERP — Environment Configuration Template
# ==============================================================================
# NOTICE: Copy this file to .env for local development. Never commit production secrets.

NODE_ENV=development

# ------------------------------------------------------------------------------
# Platform Database (PostgreSQL)
# ------------------------------------------------------------------------------
PLATFORM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xyratech_platform?schema=public"

# ------------------------------------------------------------------------------
# School Database (Default isolated school database for local dev / tenant 1)
# ------------------------------------------------------------------------------
DEFAULT_SCHOOL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xyratech_school_dev?schema=public"

# Base connection template for provisioning new school databases
SCHOOL_DB_BASE_URL="postgresql://postgres:postgres@localhost:5432"

# ------------------------------------------------------------------------------
# Redis & BullMQ Configuration
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Platform API Service (Port 4000)
# ------------------------------------------------------------------------------
PLATFORM_API_PORT=4000
PLATFORM_JWT_SECRET="replace-with-at-least-32-chars-long-platform-secret-in-production-123456"
PLATFORM_JWT_EXPIRES_IN="15m"
PLATFORM_REFRESH_TOKEN_EXPIRES_IN="7d"
PLATFORM_CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# School API Service (Port 5000)
# ------------------------------------------------------------------------------
SCHOOL_API_PORT=5000
SCHOOL_JWT_SECRET="replace-with-at-least-32-chars-long-school-secret-in-production-123456"
SCHOOL_JWT_EXPIRES_IN="15m"
SCHOOL_REFRESH_TOKEN_EXPIRES_IN="7d"
SCHOOL_CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# ------------------------------------------------------------------------------
# Encryption & Security Secrets
# ------------------------------------------------------------------------------
# 32-byte hex key for encrypting sensitive fields (e.g. MFA secrets, DB connection strings)
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# Frontend Application Endpoints
# ------------------------------------------------------------------------------
VITE_PLATFORM_API_URL="http://localhost:4000/api/v1/platform"
VITE_SCHOOL_API_URL="http://localhost:5000/api/v1/school"
